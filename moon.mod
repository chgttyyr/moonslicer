name = "chgttyyr/moonslicer"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/chgttyyr/moonslicer"

license = "Apache-2.0"

keywords = [ "3d-printing", "slicer", "stl", "gcode", "geometry", "wasm" ]

preferred_target = "wasm"

description = "Pure MoonBit 3D printing slicer: STL slicing, polygon offsetting, infill generation & G-code synthesis"

import {
